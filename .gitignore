# =========================
# PYTHON (python-ai/)
# =========================

# Virtual environment
python-ai/venv/
python-ai/.venv/
venv/
.venv/

# Python cache
python-ai/**/__pycache__/
python-ai/**/*.py[cod]
python-ai/**/*.pyo
python-ai/.pytest_cache/
python-ai/.mypy_cache/
python-ai/.ruff_cache/

# Data & vector DB (generated, tidak di-commit)
python-ai/data/
python-ai/chroma_db/
python-ai/chromadb/
python-ai/uploads/
python-ai/*.db
python-ai/*.sqlite3

# Celery
python-ai/celerybeat-schedule
python-ai/celerybeat.pid

# Logs
python-ai/logs/
python-ai/*.log

# =========================
# KELUARAN KERJA (python-ai/)
# =========================
# Semua di bawah ini DIBUAT ULANG otomatis oleh skrip. Jangan di-commit:
# isinya berubah tiap dijalankan sehingga hanya menghasilkan diff palsu,
# dan tidak ada informasi yang hilang bila terhapus.

# Cache jawaban RAG untuk --reuse (dibuat oleh test_ragas_official.py)
python-ai/.ragas_cache_phase1.json

# Dump konteks retrieval untuk penelusuran masalah (ditulis tiap query)
python-ai/debug_context.txt

# Dump isi vektor ChromaDB (dibuat oleh view_vectors.py)
python-ai/hasil_vectors.txt

# Konfigurasi Claude Code — preferensi perkakas perorangan, bukan kode proyek.
# Rekan yang mengerjakan Laravel/React tidak memakainya.
python-ai/.claude/

# CATATAN — yang berikut SENGAJA TIDAK diabaikan, karena tidak bisa dibuat
# ulang begitu saja dan menjadi bukti untuk laporan:
#   reference_eval_dataset.json/.md  ground truth, ditulis tangan
#   hasil_ragas_official.md          laporan evaluasi RAGAS
#   hasil_perbandingan_model.md      perbandingan antar model LLM
#   compare_result_*.json            data mentah pendukung laporan di atas
#   alur-sistem.html                 dokumentasi alur sistem
#   *.py                             seluruh skrip evaluasi

