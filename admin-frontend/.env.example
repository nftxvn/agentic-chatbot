# Proxy URLs (Development Lokal di luar Docker)
VITE_AI_URL=http://localhost:8080
VITE_LARAVEL_URL=http://localhost:8000

# Token Otorisasi Internal (Wajib sama persis dengan INTERNAL_API_TOKEN di python-ai/.env)
INTERNAL_API_TOKEN=dev-internal-token-secret-1234567890
AI_SERVICE_TOKEN=dev-internal-token-secret-1234567890
