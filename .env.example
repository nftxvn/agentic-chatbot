# ==============================================================================
# Konfigurasi Model AI Docker (Opsional — Sesuaikan dengan Spek Komputer/GPU)
# ==============================================================================
# Pilih model LLM teks yang ingin dipakai teman Anda (contoh: qwen2.5:7b, qwen2.5:3b, llama3.1:8b, mistral:7b)
LLM_MODEL_NAME=qwen2.5:7b

# Pilih model Vision OCR untuk ekstraksi PDF berpindai (contoh: qwen2.5vl:7b-q4_K_M, llama3.2-vision:11b)
VISION_MODEL_NAME=qwen2.5vl:7b-q4_K_M

# Alamat Ollama:
# - Gunakan http://host.docker.internal:11434 jika memakai Ollama yang sudah terpasang di Windows
# - Gunakan http://ollama:11434 jika memakai Ollama bawaan container Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434
