# Salin berkas ini menjadi .env lalu sesuaikan nilainya.
#   cp .env.example .env
# JANGAN commit .env — berkas itu memuat kredensial dan sudah di-gitignore.

# === LLM Configuration ===
# Model teks untuk chat dan ekstraksi kata kunci.
# JANGAN disamakan dengan VISION_MODEL_NAME: memakai model vision untuk chat
# membuat jawaban jauh lebih lambat tanpa manfaat apa pun.
LLM_MODEL_NAME=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# === Vision Model (untuk ekstraksi PDF hasil pindai) ===
# Sesuaikan dengan model yang sudah di-pull di Ollama. Tag yang tidak ada
# membuat Ollama membalas 404 dan SETIAP halaman gagal di-OCR.
VISION_MODEL_NAME=qwen2.5vl
# Detik. OCR di CPU bisa sangat lambat — jangan diturunkan tanpa mengukur.
VISION_TIMEOUT=1000

# === Embedding ===
# Mengganti model ini mewajibkan SELURUH dokumen di-ingest ulang: vektor lama
# dibuat dengan model berbeda dan tidak sebanding.
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# === Vector DB ===
CHROMA_PERSIST_DIR=./data/chromadb

# === Database (dipakai bersama Laravel) ===
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agentic_copilot
MYSQL_USER=root
MYSQL_PASSWORD=secret

# === Queue (Celery) ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === Security ===
# Token Bearer untuk endpoint internal (/api/docs/*, /api/chat/message, dan
# /api/chat/stream). Nilainya harus sama dengan yang dipakai Laravel.
INTERNAL_API_TOKEN=your-secure-internal-token-here

# Autentikasi untuk /api/chat/stream. BIARKAN true di jaringan instansi: tanpa
# penjaga ini, siapa pun yang menjangkau port 8000 bisa menanyai seluruh isi
# dokumen yang sudah di-ingest.
#
# Setel false HANYA untuk pengembangan lokal. React widget memanggil endpoint
# ini langsung dari browser, dan menaruh INTERNAL_API_TOKEN di sana berarti
# membocorkannya ke siapa pun yang membuka devtools — token yang sama juga
# membuka /api/docs/*. Untuk produksi, teruskan permintaan lewat Laravel yang
# menyimpan token di sisi server.
CHAT_STREAM_REQUIRE_AUTH=true

# Origin yang boleh memanggil API dari browser, dipisah koma. JANGAN diisi "*":
# dipasangkan dengan cookie/kredensial, Starlette memantulkan balik origin
# peminta sehingga penjagaan CORS-nya praktis tidak ada.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# === Batas memori LLM ===
# Batas ATAS jendela konteks (token). Nilai yang dipakai dihitung dari panjang
# konteks yang sebenarnya, lalu dibatasi di sini.
#
# TURUNKAN bila log memuat "failed to allocate buffer". Jendela besar butuh KV
# cache besar; pada mesin ber-RAM terbatas kegagalannya bergantung pada apa yang
# kebetulan sedang berjalan, sehingga pertanyaan yang sama kadang berhasil
# kadang gagal. Sebagai gambaran: 8192 cukup untuk konteks ~24.000 karakter.
LLM_MAX_NUM_CTX=16384

# === Debug (opsional) ===
# Menulis konteks retrieval terakhir ke debug_context.txt setiap ada pertanyaan.
# Berguna saat menyetel retrieval. JANGAN diaktifkan di produksi: isinya
# potongan dokumen mentah dan berkasnya ditimpa terus-menerus.
DEBUG_DUMP_CONTEXT=false

# === Evaluasi RAGAS (opsional) ===
# HANYA dipakai test_ragas_official.py sebagai model juri. Layanan berjalan
# normal tanpa ini. Ambil kunci gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Juri alternatif: DeepSeek (--deepseek). Berbayar per token, tapi tidak punya
# tembok jatah harian seperti free tier Gemini — penyebab tersering skor nan.
# Kunci dibuat di https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Nama model juri DeepSeek. Wajib berformat litellm "deepseek/<model>".
RAGAS_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash

# 1 = jangan menghubungi huggingface.co saat memuat model embedding.
# Mempercepat start bila jaringan lambat, TETAPI pada sebagian mesin justru
# menggagalkan pemuatan model (transformers melempar OfflineModeIsEnabled).
# Karena itu dibiarkan mati. Nyalakan hanya bila start terasa lama; kalau
# malah gagal, sistem otomatis mengulang tanpa mode ini dan mencatat peringatan.
# HF_HUB_OFFLINE=1
