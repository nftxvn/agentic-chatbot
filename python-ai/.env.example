# === LLM Configuration ===
# Fase 1 (Testing): qwen2.5:3b | Fase 2 (Produksi): qwen2.5:7b
LLM_MODEL_NAME=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# === Vision Model (untuk ekstraksi PDF scan) ===
# Pilihan: llava | qwen2.5vl (sesuaikan dengan model yang di-pull di Ollama)
VISION_MODEL_NAME=qwen2.5vl
VISION_TIMEOUT=240

# === Embedding ===
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# === Vector DB ===
CHROMA_PERSIST_DIR=./data/chromadb

# === Database (Shared with Laravel) ===
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agentic_copilot
MYSQL_USER=root
MYSQL_PASSWORD=secret

# === Queue (Celery) ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === Security ===
INTERNAL_API_TOKEN=your-secure-internal-token-here
