# =============================================================================
# Konfigurasi Layanan Python AI — Agentic Copilot Diskominfotik Banda Aceh
# =============================================================================
#
# Salin berkas ini menjadi `.env` lalu sesuaikan:
#
#     cp .env.example .env
#
# Nilai di bawah adalah yang DIPAKAI DI PENGEMBANGAN dan sudah teruji bersama.
# Baris yang ditandai [MESIN] berbeda-beda per komputer dan HARUS DIUKUR ULANG
# di mesin tujuan — jangan disalin buta dari laptop pengembang ke server.
#
# =============================================================================


# --- LLM (Ollama) ------------------------------------------------------------
#
# Tarik model ini lebih dulu:
#     ollama pull qwen3:8b
#     ollama pull qwen2.5vl:7b-q4_K_M
#
# CATATAN: default di app/config.py masih menyebut model lama (qwen2.5:7b).
# Selalu isi baris ini secara eksplisit; jangan mengandalkan default kode.
LLM_MODEL_NAME=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Model vision untuk OCR halaman hasil pindai.
VISION_MODEL_NAME=qwen2.5vl:7b-q4_K_M
# Batas waktu satu panggilan vision (detik). OCR satu halaman bisa 60-150 detik
# bila model vision tidak muat seluruhnya di GPU (misal RTX 3050 4GB/6GB).
VISION_TIMEOUT=300


# --- Embedding ---------------------------------------------------------------
#
# CATATAN: default di app/config.py masih MiniLM. Isi eksplisit.
# Mengganti model ini WAJIB diikuti reindex seluruh dokumen — vektor lama
# dibuat oleh model lama dan tidak sebanding.
EMBEDDING_MODEL_NAME=BAAI/bge-m3


# --- Vector DB (ChromaDB) ----------------------------------------------------
CHROMA_PERSIST_DIR=./data/chromadb

# Untuk API dan worker pada proses terpisah, gunakan satu server Chroma bersama.
# Contoh lokal: chroma run --path ./data/chromadb --host 127.0.0.1 --port 9090
# Host kosong mempertahankan PersistentClient embedded untuk satu proses.
CHROMA_HTTP_HOST=
CHROMA_HTTP_PORT=9090
CHROMA_HTTP_SSL=false


# --- MySQL (dipakai bersama Laravel) -----------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agentic_copilot
MYSQL_USER=ganti_user
MYSQL_PASSWORD=ganti_password

# Opsional: instance Laravel tujuan callback handoff. Jika diberikan, callback
# hanya mencoba instance ini; tidak fallback ke hostname/port instance lain.
# Kosongkan untuk memakai daftar discovery lama (Docker/local pada port 8000).
LARAVEL_BASE_URL=


# --- Celery / Redis ----------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# --- Keamanan ----------------------------------------------------------------
#
# Token yang membuka /api/docs/* dan /api/chat/message. Nilai yang sama harus
# dipasang di Laravel (.env: AI_SERVICE_TOKEN).
# Buat yang baru dengan:  openssl rand -hex 32
INTERNAL_API_TOKEN=ganti_dengan_token_acak_yang_panjang

# Wajibkan Authorization pada POST /api/chat/stream.
#
# BIARKAN true DI PRODUKSI. Tanpa penjaga ini, siapa pun yang bisa menjangkau
# port 8080 dapat menanyai seluruh isi dokumen yang sudah di-ingest.
# Boleh false hanya di localhost saat pengembangan, karena React widget
# memanggil endpoint ini langsung dari browser.
CHAT_STREAM_REQUIRE_AUTH=true

# Origin yang boleh memanggil dari browser, dipisah koma.
# JANGAN "*" — dipasangkan dengan allow_credentials, situs mana pun jadi bisa
# memanggil API ini memakai kredensial pengunjungnya.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Jendela konteks LLM -----------------------------------------------------
#
# DIPATOK ke satu nilai, jangan dihitung dinamis. Di Ollama, setiap nilai
# num_ctx berbeda memaksa llama-server dimuat ulang dari nol (~23-50 detik).
# Nilai ini harus sama di seluruh pemanggilan model teks.
#
# 8192 muat untuk konteks ~24.000 karakter. Menaikkannya menambah pemakaian
# KV cache: 144 KiB per token (f16) atau 72 KiB (q8_0).
LLM_NUM_CTX=8192


# =============================================================================
# [MESIN] Setelan yang bergantung perangkat keras
# =============================================================================
#
# Keduanya di bawah ini SENGAJA dibiarkan kosong/aman di default kode
# (LLM_NUM_GPU=0, EMBEDDING_DEVICE=auto). Isi hanya setelah mengukur mesinnya.
#
# Prosedur singkat di mesin baru:
#   1. Pasang tanpa mengisi kedua baris di bawah, jalankan satu pertanyaan.
#   2. journalctl -u ollama | grep -E "offloaded|buffer|graph splits"
#      -> catat "offloaded N/37 layers", "CUDA0 model buffer", "KV buffer".
#   3. nvidia-smi --query-gpu=memory.total,memory.used,memory.free --format=csv
#      -> saat idle dan saat menjawab.
#   4. Hitung: model + KV + compute + pemakaian OS < kapasitas kartu?
#      Bila offload sudah 100%, JANGAN isi apa pun. Selesai.
#   5. Bila masih terpecah padahal aritmetikanya muat, baru pakai setelan ini.
#   6. Selalu bandingkan dua sisi berurutan dalam satu sesi. Throughput mesin
#      bisa berayun 2x tanpa sebab yang terlihat; satu pembacaan tidak cukup.
#
# -----------------------------------------------------------------------------
# Jumlah layer yang dipaksa ke GPU. 0 = serahkan ke auto-fit Ollama (AMAN).
#
# BAHAYA: nilai kelewat tinggi TIDAK memberi pesan galat. VRAM kelebihan muatan
# lalu melimpah diam-diam ke RAM host, "ollama ps" tetap menulis 100% GPU,
# dan kecepatan justru turun. Di laptop pengembangan hal ini terukur sebagai
# 12,9 -> 5,5 tok/dtk.
#
# Isi hanya bila kartunya sempit dan aritmetika VRAM membuktikan modelnya muat.
# Prasyaratnya EMBEDDING_DEVICE=cpu DAN OLLAMA_KV_CACHE_TYPE=q8_0 di systemd.
# LLM_NUM_GPU=99

# Perangkat model embedding: auto | cpu | cuda.
#
# "auto" (default) memilih CUDA bila tersedia — benar untuk mesin ber-VRAM lega.
# Setel "cpu" hanya bila VRAM diperebutkan dengan LLM: bge-m3 memakan 2272 MiB,
# dan di kartu 6 GB itulah yang menghalangi LLM masuk seluruhnya.
# Ongkos pindah ke CPU kecil (~100 ms per query) karena yang di-embed saat chat
# hanya kalimat pertanyaan; embedding dokumen sudah tersimpan sejak ingest.
# EMBEDDING_DEVICE=cpu

# -----------------------------------------------------------------------------
# Setelan Ollama di tingkat systemd (BUKAN berkas ini, dan butuh akses root).
# Hanya perlu bila kartunya sempit. q8_0 memangkas KV cache jadi separuh.
#
#   sudo mkdir -p /etc/systemd/system/ollama.service.d
#   sudo tee /etc/systemd/system/ollama.service.d/override.conf > /dev/null <<'EOF'
#   [Service]
#   Environment="OLLAMA_FLASH_ATTENTION=1"
#   Environment="OLLAMA_KV_CACHE_TYPE=q8_0"
#   EOF
#   sudo systemctl daemon-reload && sudo systemctl restart ollama
#
# JANGAN pakai q4_0 — merusak recall konteks panjang.
# =============================================================================


# --- Debug -------------------------------------------------------------------
#
# Menulis konteks retrieval terakhir ke debug_context.txt setiap ada pertanyaan.
# JANGAN diaktifkan di produksi: isinya potongan dokumen mentah.
DEBUG_DUMP_CONTEXT=false

# Hentikan pemeriksaan pembaruan model ke huggingface.co saat startup.
# Berguna bila jaringan server lambat atau diblokir. Bila pemuatan model justru
# gagal karenanya, aplikasi otomatis mengulang sekali tanpa mode luring.
# HF_HUB_OFFLINE=1
